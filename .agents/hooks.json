{
  "workspace-hygiene": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ..\\tools\\check_workspace_hygiene.ps1 -Hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
